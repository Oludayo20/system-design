# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# One instance, schema-per-module (catalog, basket, ordering, identity).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eshop
POSTGRES_PASSWORD=eshop_dev_password
POSTGRES_DB=eshop

# --- Redis ---
# Sessions, refresh tokens, product cache-aside, rate limiting.
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
# Domain event bus. Topic exchange `domain_events`.
RABBITMQ_URL=amqp://eshop:eshop_dev_password@localhost:5672

# --- Identity / JWT ---
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1h
