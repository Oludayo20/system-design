# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Stores rides (the only durable, synchronous write the producer performs).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=async_demo
POSTGRES_PASSWORD=async_demo_password
POSTGRES_DB=async_demo

# --- RabbitMQ ---
# Topic exchange `ride_events`. See README for the full retry/DLQ topology.
RABBITMQ_USER=async_demo
RABBITMQ_PASSWORD=async_demo_password
RABBITMQ_URL=amqp://async_demo:async_demo_password@localhost:5672

# --- Kafka ---
# Only used by the standalone broadcast-comparison scripts (src/kafka/*), not by the API/worker.
KAFKA_BROKERS=localhost:9092

# --- Email worker failure simulation ---
# Fraction (0-1) of email jobs the Email worker randomly fails, so the retry + DLQ path is
# exercisable without needing to break anything by hand. Set to 0 to disable.
EMAIL_FAILURE_RATE=0.3
