# --- App ---
NODE_ENV=development
PORT=3000
# Identifies which replica answered a request in logs (set per-container in compose).
INSTANCE_ID=api-1

# --- Identity / JWT ---
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1h

# --- PostgreSQL: primary (Marketplace / Orders / Notifications + the email->shard directory) ---
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=5432
PRIMARY_DB_USER=oja
PRIMARY_DB_PASSWORD=oja_dev_password
PRIMARY_DB_NAME=oja_primary

# --- PostgreSQL: shards (Users + Wallets, sharded by hash(userId) % 3) ---
SHARD_COUNT=3

SHARD0_DB_HOST=localhost
SHARD0_DB_PORT=5433
SHARD0_DB_USER=oja
SHARD0_DB_PASSWORD=oja_dev_password
SHARD0_DB_NAME=oja_shard0

SHARD1_DB_HOST=localhost
SHARD1_DB_PORT=5434
SHARD1_DB_USER=oja
SHARD1_DB_PASSWORD=oja_dev_password
SHARD1_DB_NAME=oja_shard1

SHARD2_DB_HOST=localhost
SHARD2_DB_PORT=5435
SHARD2_DB_USER=oja
SHARD2_DB_PASSWORD=oja_dev_password
SHARD2_DB_NAME=oja_shard2

# --- Redis (cache & sessions) ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (internal event bus, topic exchange `domain_events`) ---
RABBITMQ_URL=amqp://oja:oja_dev_password@localhost:5672
