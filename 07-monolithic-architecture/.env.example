# --- App ---
NODE_ENV=development
PORT=3007

# --- PostgreSQL ---
# One instance, one database, no schema-per-module split — BlogStack is the "everything shares
# one DB" version of the monolith, in contrast to 01-modular-monolith's schema-per-module setup.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=blogstack
POSTGRES_PASSWORD=blogstack_dev_password
POSTGRES_DB=blogstack

# --- Auth / JWT ---
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1h
