# BookHive — env vars for every service, sectioned by owner.
#
# docker-compose.yml only forwards the variables each service actually needs
# into that service's container (see the `environment:` block per service).
# Nobody gets a blanket dump of this whole file - that's deliberate: it's
# what makes "auth-service has no idea catalog-db exists" true rather than
# just claimed. Copy this to `.env` before running docker compose.

# ============================================================
# Gateway (port 3008) — the only service exposed to "the internet"
# ============================================================
GATEWAY_PORT=3008
AUTH_SERVICE_URL=http://auth-service:4001
CATALOG_SERVICE_URL=http://catalog-service:4002
ORDER_SERVICE_URL=http://order-service:4003
NOTIFICATION_SERVICE_URL=http://notification-service:4004
# Token-bucket rate limiter, per client IP.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=10

# ============================================================
# Shared JWT secret — every service verifies tokens independently
# (same trick as 04-ecom-marketplace-capstone's api-1/api-2: a stateless
# HS256 check needs no shared session store and no network call back to
# auth-service). This is an application credential, not a database
# credential, so sharing it does not break the "own database" rule.
# ============================================================
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1h

# ============================================================
# Auth Service (port 4001) — register/login/verify. Owns auth-db.
# ============================================================
AUTH_SERVICE_PORT=4001
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=bookhive
AUTH_DB_PASSWORD=bookhive_dev_password
AUTH_DB_NAME=auth_db
# Host-mapped port for auth-db, for direct `psql` inspection only.
AUTH_DB_HOST_PORT=5436

# ============================================================
# Catalog Service (port 4002) — books + stock. Owns catalog-db.
# ============================================================
CATALOG_SERVICE_PORT=4002
CATALOG_DB_HOST=catalog-db
CATALOG_DB_PORT=5432
CATALOG_DB_USER=bookhive
CATALOG_DB_PASSWORD=bookhive_dev_password
CATALOG_DB_NAME=catalog_db
CATALOG_DB_HOST_PORT=5437

# ============================================================
# Order Service (port 4003) — places orders. Owns order-db.
# Notice: no CATALOG_DB_* or AUTH_DB_* vars anywhere in this section.
# order-service reaches the catalog only over HTTP, via CATALOG_SERVICE_URL.
# ============================================================
ORDER_SERVICE_PORT=4003
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432
ORDER_DB_USER=bookhive
ORDER_DB_PASSWORD=bookhive_dev_password
ORDER_DB_NAME=order_db
ORDER_DB_HOST_PORT=5438
# How long order-service waits on the fire-and-forget notification call
# before giving up and swallowing the error (fault isolation, see README).
NOTIFICATION_TIMEOUT_MS=2000

# ============================================================
# Notification Service (port 4004) — in-memory notification log, no DB.
# ============================================================
NOTIFICATION_SERVICE_PORT=4004
