# --- order-api ---
ORDER_API_PORT=3009

# --- order-db (Postgres, owned by order-api only) ---
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_USER=freshcart
ORDER_DB_PASSWORD=freshcart_password
ORDER_DB_NAME=order_db

# --- inventory-db (Postgres, owned by inventory-consumer only) ---
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5433
INVENTORY_DB_USER=freshcart
INVENTORY_DB_PASSWORD=freshcart_password
INVENTORY_DB_NAME=inventory_db

# --- RabbitMQ ---
# Topic exchange `grocery_events`. order-api only ever publishes to it — it has no idea which
# queues (if any) are bound to it. See README for the fan-out topology.
RABBITMQ_USER=freshcart
RABBITMQ_PASSWORD=freshcart_password
RABBITMQ_URL=amqp://freshcart:freshcart_password@localhost:5672

# --- Consumer ports (each independent app, only used for its own inspection endpoint) ---
INVENTORY_CONSUMER_PORT=4101
NOTIFICATION_CONSUMER_PORT=4102
ANALYTICS_CONSUMER_PORT=4103
LOYALTY_CONSUMER_PORT=4104
