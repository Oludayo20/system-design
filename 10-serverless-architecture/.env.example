# --- App / API Gateway trigger ---
PORT=3010

# --- Execution environment manager ---
# How long an idle (warm) instance is kept alive before the sweeper evicts it (scale-to-zero).
# Real AWS Lambda keeps warm containers for minutes to ~an hour; this is shortened so the
# cold -> warm -> cold cycle is demoable in a single terminal session.
WARM_TTL_MS=60000

# Extra latency (ms) injected on every cold start to simulate a fresh execution environment
# initializing (container boot + module load + module-level init code). This is a REAL added
# delay, not a fake label — curl timing will show it.
COLD_START_LATENCY_MS=400

# How often (ms) the schedule trigger invokes dailySalesReport. Stands in for a cron expression
# (e.g. "rate(1 day)" in real EventBridge/CloudWatch Events).
SCHEDULE_INTERVAL_MS=30000

# --- Queue trigger (simulates SQS -> Lambda) ---
RABBITMQ_URL=amqp://serverless_demo:serverless_demo_password@localhost:5673
RABBITMQ_USER=serverless_demo
RABBITMQ_PASSWORD=serverless_demo_password
