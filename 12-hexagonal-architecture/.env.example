# --- App ---
NODE_ENV=development
PORT=3012

# --- Adapter selection ---
# This is the whole point of the project: flip these and restart, nothing in src/core changes.
# REPOSITORY: memory | postgres
REPOSITORY=memory
# PAYMENT_PROVIDER: stripe | flutterwave
PAYMENT_PROVIDER=stripe

# --- PostgreSQL (only read when REPOSITORY=postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_dev_password
POSTGRES_DB=orbit
